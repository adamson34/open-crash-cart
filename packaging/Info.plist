    <key>SUFeedURL</key>
    <string>https://adamson34.github.io/open-crash-cart/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>afN3LFYcAKvD4JpuLAw8xuL4+Iotain6RZz8eMvOHz4=</string>
